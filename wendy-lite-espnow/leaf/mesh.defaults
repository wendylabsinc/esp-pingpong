# Local, not committed: signed mesh leaf over the ESP-NOW carrier proxy.
CONFIG_LWIP_HOOK_IP6_ROUTE_CUSTOM=y
CONFIG_LWIP_IPV6_FORWARD=n
CONFIG_LWIP_NETIF_LOOPBACK=y
CONFIG_WENDY_MESH_LEAF=y
CONFIG_WENDY_MESH_TCP=y
CONFIG_WENDY_MESH_AUTO_DISCOVER=n
CONFIG_WENDY_MESH_ROUTER_HOST="127.0.0.1"
CONFIG_WENDY_MESH_ROUTER_DEVICE="f0d76aed-b590-4225-905a-08a2d278f9dd"
CONFIG_WENDY_MESH_ROUTER_PORT=43124
CONFIG_WENDY_ESPNOW=y
CONFIG_WENDY_ESPNOW_PROXY_PORT=43124
CONFIG_WENDY_ESPNOW_LOG_BEACONS=y
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
CONFIG_WENDY_ESPNOW_LOG_AP_BEACONS=y

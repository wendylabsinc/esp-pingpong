CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_BT_ENABLED=n
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# No modem sleep: the receive stamp is only precise with the radio awake.
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
# More Wi-Fi receive buffers: the radio acknowledges a frame in hardware and
# the driver drops it afterwards if no buffer is free, which the sender never
# learns about. Three nodes sending fragments at once filled the defaults.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
